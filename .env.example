# ==============================================
# EduOS - Environment Configuration (Copy to .env)
# ==============================================

NODE_ENV=development

# --- API Server ---
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend ---
WEB_PORT=3000

# --- PostgreSQL ---
POSTGRES_DB=eduos
POSTGRES_USER=eduos
POSTGRES_PASSWORD=eduos_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-super-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-super-secret-32chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate Limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=900000
THROTTLE_AUTH_LIMIT=10

# --- Storage (Object storage: s3 / minio / local) ---
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=your-secret-access-key-here
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_ROOT=storage

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Seed ---
SEED_ADMIN_EMAIL=admin@eduos.local
SEED_ADMIN_PASSWORD=ChangeMe123!

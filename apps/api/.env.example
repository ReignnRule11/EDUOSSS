# Copy to .env and fill in real values. Never commit .env.

# App
NODE_ENV=development
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
# Set true only behind a trusted reverse proxy (correct client IP + tenant host)
TRUST_PROXY=false
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=eduos
POSTGRES_USER=eduos
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eduos:change-me@localhost:5432/eduos

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Set a Redis password in production (redis://:password@host:6379)
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

# Auth (generate strong secrets, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MS=900000
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFY_TTL_SECONDS=86400
MFA_ENABLED=false
MFA_ISSUER=EduOS
MFA_WINDOW_SECONDS=30
MFA_BACKUP_CODE_COUNT=10
AUTH_PUBLIC_BASE_URL=http://localhost:3000

# Mail (SMTP)
EMAIL_FROM=EduOS <no-reply@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

# Storage
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_ROOT=./storage

# Swagger
SWAGGER_ENABLED=true  # defaults to false in production
SWAGGER_PATH=docs

# Seed (dev only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

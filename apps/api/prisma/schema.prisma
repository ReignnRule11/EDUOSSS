// =============================================================
// Computer Based Testing (CBT)
// =============================================================

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
  TRUE_FALSE
  MATCHING
  FILL_BLANK
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED
}

model QuestionCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  questions Question[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("question_categories")
}

model Question {
  id            String           @id @default(cuid())
  tenantId      String
  categoryId    String?
  createdById   String
  type          QuestionType
  difficulty    QuestionDifficulty @default(MEDIUM)
  body          String
  options       Json? // MCQ: [{id,text,isCorrect}], MATCHING: {left:[{id,text}], right:[{id,text}]}
  correctAnswer Json? // MCQ: {optionId}, TF: {value}, FILL_BLANK: {answers:[...]}, MATCHING: {pairs:[{leftId,rightId}]}
  explanation   String?
  points        Int              @default(1)
  status        QuestionStatus   @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  category    QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("QuestionCreator", fields: [createdById], references: [id])
  examQuestions ExamQuestion[]

  @@index([tenantId, type, difficulty])
  @@index([tenantId, categoryId])
  @@map("questions")
}

model Exam {
  id                  String     @id @default(cuid())
  tenantId            String
  courseId            String?
  subjectId           String?
  createdById         String
  title               String
  description         String?
  durationMinutes     Int        @default(60)
  passMark            Int        @default(50)
  negativeMarking     Boolean    @default(false)
  negativeMarkingValue Float     @default(0.25)
  shuffleQuestions    Boolean    @default(true)
  shuffleOptions      Boolean    @default(true)
  showResultsOnSubmit Boolean    @default(true)
  maxAttempts         Int        @default(1)
  randomPickConfig    Json?
  randomPickCount     Int?
  status              ExamStatus @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subject   Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy User          @relation("ExamCreator", fields: [createdById], references: [id])
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([tenantId, status])
  @@index([tenantId, courseId])
  @@map("exams")
}

model ExamQuestion {
  id         String @id @default(cuid())
  tenantId   String
  examId     String
  questionId String
  orderIndex Int    @default(0)
  points     Int    @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@unique([examId, orderIndex])
  @@index([tenantId, examId])
  @@map("exam_questions")
}

model ExamAttempt {
  id          String           @id @default(cuid())
  tenantId    String
  examId      String
  studentId   String
  status      ExamAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime         @default(now())
  submittedAt DateTime?
  expiresAt   DateTime
  answers     Json? // { questionId: answer }
  questionOrder Json? // randomized questionId order (shuffled)
  autoScore   Float            @default(0)
  essayScore  Float            @default(0)
  totalScore  Float?
  results     Json? // [{questionId,type,points,score,correct,answer,correctAnswer,feedback}]
  gradedById  String?
  gradedAt    DateTime?
  lastSavedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id])
  gradedBy User?  @relation("AttemptGradedBy", fields: [gradedById], references: [id])

  @@index([tenantId, examId, status])
  @@index([tenantId, studentId])
  @@map("exam_attempts")
}

// ---------- Result Processing ----------

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RELEASED
}

model ResultScale {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  description String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  entries ResultScaleEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("result_scales")
}

model ResultScaleEntry {
  id           String  @id @default(cuid())
  tenantId     String
  scaleId      String
  minScore     Float
  maxScore     Float
  letterGrade  String
  gpa          Float
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  scale  ResultScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@index([tenantId, scaleId])
  @@map("result_scale_entries")
}

model TermResult {
  id             String       @id @default(cuid())
  tenantId       String
  studentId      String
  classGroupId   String
  academicYear   String
  term           GradeTerm
  status         ResultStatus @default(DRAFT)
  caWeight       Float        @default(0.3)
  examWeight     Float        @default(0.7)
  totalScore     Float?
  totalMaxScore  Float?
  average        Float?
  classPosition  Int?
  classSize      Int?
  teacherComment String?
  principalComment String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  approvedBy User?              @relation("TermResultApprover", fields: [approvedById], references: [id])
  subjects   SubjectResult[]

  @@unique([tenantId, studentId, classGroupId, academicYear, term])
  @@index([tenantId, classGroupId, academicYear, term, status])
  @@map("term_results")
}

model SubjectResult {
  id           String   @id @default(cuid())
  tenantId     String
  termResultId String
  subjectId    String
  caScore      Float?
  examScore    Float?
  totalScore   Float?
  letterGrade  String?
  gpa          Float?
  remark       String?
  position     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  termResult TermResult @relation(fields: [termResultId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, termResultId, subjectId])
  @@index([tenantId, subjectId])
  @@map("subject_results")
}

// ---------- Finance ----------

enum FeeType {
  TUITION
  SPORTS
  LIBRARY
  TECHNOLOGY
  TRANSPORT
  DEVELOPMENT
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  PAYSTACK
  FLUTTERWAVE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model FeeStructure {
  id           String   @id @default(cuid())
  tenantId     String
  classGroupId String
  academicYear String
  term         String
  name         String
  feeType      FeeType  @default(TUITION)
  amount       Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classGroupId, academicYear, term, name])
  @@index([tenantId, classGroupId, academicYear, term])
  @@map("fee_structures")
}

model Invoice {
  id              String        @id @default(cuid())
  tenantId        String
  invoiceNumber   String
  studentId       String
  classGroupId    String
  academicYear    String
  term            String
  status          InvoiceStatus @default(ISSUED)
  totalAmount     Float
  discountAmount  Float         @default(0)
  scholarshipAmount Float       @default(0)
  paidAmount      Float         @default(0)
  balanceAmount   Float
  dueDate         DateTime?
  issuedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup    @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  items      InvoiceItem[]
  payments   Payment[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, studentId, classGroupId, academicYear, term])
  @@index([tenantId, studentId, status])
  @@index([tenantId, classGroupId, academicYear, term])
  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(cuid())
  tenantId     String
  invoiceId    String
  name         String
  description  String?
  amount       Float
  createdAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceId     String
  studentId     String
  reference     String
  amount        Float
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(COMPLETED)
  gateway       String?
  gatewayRef    String?
  paidAt        DateTime?
  recordedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  receipt    Receipt?

  @@unique([tenantId, reference])
  @@index([tenantId, studentId, status])
  @@index([tenantId, invoiceId])
  @@index([tenantId, createdAt])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(cuid())
  tenantId      String
  paymentId     String   @unique
  receiptNumber String
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, issuedAt])
  @@map("receipts")
}

model Discount {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  type      DiscountType @default(PERCENTAGE)
  value     Float
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("discounts")
}

model Scholarship {
  id        String       @id @default(cuid())
  tenantId  String
  studentId String
  name      String
  type      DiscountType @default(PERCENTAGE)
  value     Float
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, isActive])
  @@map("scholarships")
}

// ---------- Parent Portal ----------

model ParentMessage {
  id         String   @id @default(cuid())
  tenantId   String
  studentId  String
  senderId   String
  receiverId String
  subject    String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sender   User    @relation("MessageSender", fields: [senderId], references: [id])
  receiver User    @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, receiverId, readAt])
  @@map("parent_messages")
}

// ---------- AI Services ----------

enum AiFeature {
  LESSON_PLANNER
  QUESTION_GENERATOR
  REPORT_COMMENT
  TUTOR
  RECOMMENDATION
  INSIGHT
}

model AiPromptTemplate {
  id         String     @id @default(cuid())
  tenantId   String
  feature    AiFeature
  name       String
  prompt     String
  variables  String[]   @default([])
  isActive   Boolean    @default(true)
  isDefault  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, feature, name])
  @@index([tenantId, feature, isActive])
  @@map("ai_prompt_templates")
}

model AiUsageLog {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String?
  feature          AiFeature
  model            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  status           String    @default("SUCCESS")
  error            String?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, feature])
  @@map("ai_usage_logs")
}

// ---------- Push Notifications ----------

model PushSubscription {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  endpoint     String   @unique
  keys         Json
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, endpoint])
  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

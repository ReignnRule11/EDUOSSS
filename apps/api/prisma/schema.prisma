model Certificate {
  id                String   @id @default(cuid())
  tenantId          String
  courseId          String
  enrollmentId      String   @unique
  studentId         String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  pdfUrl            String?
  earnedScore       Float?

  tenant    Tenant           @relation(fields: [tenantId], references: [id])

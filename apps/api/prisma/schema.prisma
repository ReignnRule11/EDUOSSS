// =============================================================
// LMS
// =============================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LmsEnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model Course {
  id           String       @id @default(cuid())
  tenantId     String
  schoolId     String?
  subjectId    String?
  title        String
  slug         String       @unique
  summary      String?
  description  String?
  level        String?
  thumbnailUrl String?
  instructorId String?
  status       CourseStatus @default(DRAFT)
  isFree       Boolean      @default(false)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  school           School?            @relation(fields: [schoolId], references: [id])
  subject          Subject?           @relation(fields: [subjectId], references: [id])
  instructor       Teacher?           @relation(fields: [instructorId], references: [id])
  lessons          CourseLesson[]
  enrollments      CourseEnrollment[]
  forumThreads     ForumThread[]
  assignments      CourseAssignment[]
  homeworks        CourseHomework[]
  liveClasses      LiveClass[]
  recordedSessions RecordedSession[]
  certificates     Certificate[]
  exams            Exam[]

  @@index([tenantId, status])
  @@map("courses")
}

model CourseLesson {
  id              String   @id @default(cuid())
  tenantId        String
  courseId        String
  title           String
  summary         String?
  content         String?
  videoUrl        String?
  audioUrl        String?
  pdfUrl          String?
  orderIndex      Int      @default(0)
  durationMinutes Int?
  isFree          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  course   Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress CourseLessonProgress[]
  assignments CourseAssignment[]
  homeworks    CourseHomework[]
  recordedSessions RecordedSession[]

  @@unique([courseId, orderIndex])
  @@index([tenantId, courseId])
  @@map("course_lessons")
}

model CourseEnrollment {
  id              String             @id @default(cuid())
  tenantId        String
  courseId        String
  studentId       String
  status          LmsEnrollmentStatus @default(ACTIVE)
  progressPercent Float              @default(0)
  enrolledAt      DateTime           @default(now())
  completedAt     DateTime?

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student          Student                @relation(fields: [studentId], references: [id])
  certificate      Certificate?
  lessonProgress   CourseLessonProgress[]
  assignmentSubs   AssignmentSubmission[]
  homeworkSubs     HomeworkSubmission[]

  @@unique([courseId, studentId])
  @@index([tenantId, courseId])
  @@index([tenantId, studentId])
  @@map("course_enrollments")
}

model CourseLessonProgress {
  id              String              @id @default(cuid())
  tenantId        String
  enrollmentId    String
  lessonId        String
  status          LessonProgressStatus @default(NOT_STARTED)
  progressPercent Float               @default(0)
  lastPosition    Int?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([tenantId, enrollmentId])
  @@map("course_lesson_progress")
}

model ForumThread {
  id        String   @id @default(cuid())
  tenantId  String
  courseId  String
  authorId  String
  title     String

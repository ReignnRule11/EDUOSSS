// ============================================================
// EduOS - Prisma Schema
// Multi-tenant School Management System
//
// Isolation strategy: every tenant-scoped model carries a
// `tenantId` column. A composite unique index (tenantId + code)
// guarantees tenant-local uniqueness. All data access MUST scope
// queries with the current tenantId (enforced by repositories and
// the global TenantGuard).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Core: Identity & Tenancy ----------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
}

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  // ---- Branding ----
  logoUrl  String?
  branding Json?

  // ---- Subscription ----
  plan                  String    @default("FREE")
  subscriptionStatus    String    @default("TRIAL")
  subscriptionExpiresAt DateTime?
  seats                 Int       @default(5)

  // ---- Enabled modules ----
  enabledModules String[] @default(["academics", "attendance", "grades", "finance"])

  // ---- Storage usage (bytes) ----
  storageUsed  BigInt @default(0)
  storageQuota BigInt @default(10737418240)

  settings  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                  User[]
  schools                School[]
  students               Student[]
  teachers               Teacher[]
  classes                ClassGroup[]
  subjects               Subject[]
  enrollments            Enrollment[]
  attendance             AttendanceRecord[]
  parentNotificationLogs ParentNotificationLog[]
  grades                 Grade[]
  auditLogs              AuditLog[]
  files                  StoredFile[]
  sessions               RefreshToken[]
  domains                TenantDomain[]
  memberships            UserTenant[]
  classSub               ClassSubject[]
  PasswordResetToken     PasswordResetToken[]
  EmailVerificationToken EmailVerificationToken[]
  academicSessions       AcademicSession[]
  academicTerms          AcademicTerm[]
  departments            Department[]
  timetableSlots         TimetableSlot[]
  announcements          Announcement[]
  guardians              Guardian[]
  medicalRecords         MedicalRecord[]
  disciplineRecords      DisciplineRecord[]
  studentDocuments       StudentDocument[]
  transfers              StudentTransfer[]
  promotions             StudentPromotion[]
  timelineEvents         TimelineEvent[]
  teacherQualifications  TeacherQualification[]
  teacherEmploymentHistory TeacherEmploymentHistory[]
  teacherAttendance      TeacherAttendance[]
  teacherPerformanceReviews TeacherPerformanceReview[]
  teacherLeaveRequests   TeacherLeaveRequest[]
  teacherSalaries        TeacherSalary[]
  teacherDocuments       TeacherDocument[]
  courses                Course[]
  courseLessons          CourseLesson[]
  courseEnrollments      CourseEnrollment[]
  courseLessonProgress   CourseLessonProgress[]
  forumThreads           ForumThread[]
  forumReplies           ForumReply[]
  courseAssignments      CourseAssignment[]
  assignmentSubmissions  AssignmentSubmission[]
  courseHomeworks        CourseHomework[]
  homeworkSubmissions    HomeworkSubmission[]
  liveClasses            LiveClass[]
  recordedSessions       RecordedSession[]
  certificates           Certificate[]
  questionCategories     QuestionCategory[]
  questions              Question[]
  exams                  Exam[]
  examQuestions          ExamQuestion[]
  examAttempts           ExamAttempt[]
  resultScales           ResultScale[]
  resultScaleEntries     ResultScaleEntry[]
  termResults            TermResult[]
  subjectResults         SubjectResult[]
  feeStructures          FeeStructure[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  receipts               Receipt[]
  discounts              Discount[]
  scholarships           Scholarship[]
  parentMessages         ParentMessage[]
  aiPromptTemplates      AiPromptTemplate[]
  aiUsageLogs            AiUsageLog[]
  pushSubscriptions      PushSubscription[]

  @@index([slug])
  @@map("tenants")
}

model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  domain     String    @unique
  isVerified Boolean   @default(false)
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isVerified])
  @@map("tenant_domains")
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("user_tenants")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  LOCKED
}

model User {
  id               String     @id @default(cuid())
  tenantId         String
  email            String
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  role             String
  status           UserStatus @default(PENDING)
  emailVerifiedAt  DateTime?
  mfaEnabled       Boolean    @default(false)
  mfaSecret        String?
  mfaBackupCodes   String[]   @default([])
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  sessions                RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  uploadedFiles           StoredFile[]
  memberships             UserTenant[]
  student                 Student?
  teacher                 Teacher?
  announcements           Announcement[]
  createdAssignments      CourseAssignment[] @relation("AssignmentCreator")
  createdHomeworks        CourseHomework[] @relation("HomeworkCreator")
  gradedAssignments       AssignmentSubmission[] @relation("AssignmentGradedBy")
  gradedHomework          HomeworkSubmission[] @relation("HomeworkGradedBy")
  createdLiveClasses      LiveClass[]
  forumThreads            ForumThread[] @relation("ForumThreadAuthor")
  forumReplies            ForumReply[] @relation("ForumReplyAuthor")
  createdQuestions        Question[] @relation("QuestionCreator")
  createdExams            Exam[] @relation("ExamCreator")
  gradedAttempts          ExamAttempt[] @relation("AttemptGradedBy")
  approvedTermResults     TermResult[] @relation("TermResultApprover")
  recordedPayments        Payment[] @relation("PaymentRecordedBy")
  sentMessages            ParentMessage[] @relation("MessageSender")
  receivedMessages        ParentMessage[] @relation("MessageReceiver")
  aiUsageLogs             AiUsageLog[]
  pushSubscriptions       PushSubscription[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  sessionId  String?
  tokenHash  String
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  replacedBy String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

// ---------- Academic Domain ----------

enum SchoolType {
  PRIMARY
  SECONDARY
  K_12
  INTERNATIONAL
  VOCATIONAL
  UNIVERSITY
}

model School {
  id              String     @id @default(cuid())
  tenantId        String
  name            String
  code            String
  type            SchoolType @default(K_12)
  address         String?
  phone           String?
  email           String?
  website         String?
  establishedYear Int?
  motto           String?
  logoUrl         String?
  academicYear    String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  students Student[]
  teachers Teacher[]
  classes  ClassGroup[]
  departments Department[]
  timetableSlots TimetableSlot[]
  transfersFrom StudentTransfer[] @relation("TransferFromSchool")
  transfersTo   StudentTransfer[] @relation("TransferToSchool")
  courses       Course[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("schools")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  DROPPED
}

model Student {
  id              String         @id @default(cuid())
  tenantId        String
  schoolId        String
  userId          String?        @unique
  admissionNumber String
  firstName       String
  lastName        String
  gender          Gender
  dateOfBirth     DateTime?
  gradeLevel      String
  academicStatus  AcademicStatus @default(ACTIVE)
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?
  address         String?
  photoUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  school      School             @relation(fields: [schoolId], references: [id])
  user        User?              @relation(fields: [userId], references: [id])
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  notifications ParentNotificationLog[]
  grades      Grade[]
  guardians   Guardian[]
  medicalRecords MedicalRecord[]
  disciplineRecords DisciplineRecord[]
  documents   StudentDocument[]
  transfers   StudentTransfer[]
  promotions  StudentPromotion[]
  timelineEvents TimelineEvent[]
  courseEnrollments CourseEnrollment[]
  certificates      Certificate[]
  examAttempts      ExamAttempt[]
  termResults       TermResult[]
  invoices          Invoice[]
  payments          Payment[]
  scholarships      Scholarship[]
  parentMessages    ParentMessage[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, schoolId])
  @@index([tenantId, firstName, lastName])
  @@map("students")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
}

model Teacher {
  id             String         @id @default(cuid())
  tenantId       String
  schoolId       String
  departmentId   String?
  userId         String?        @unique
  staffNumber    String
  firstName      String
  lastName       String
  gender         Gender?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  nationalId     String?
  specialization String?
  employmentType EmploymentType @default(FULL_TIME)
  joinedAt       DateTime?
  photoUrl       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  school        School         @relation(fields: [schoolId], references: [id])
  department    Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  classGroups   ClassGroup[]
  subjectAssign ClassSubject[]
  timetableSlots TimetableSlot[]
  headOfDepartments Department[] @relation("DepartmentHead")
  qualifications TeacherQualification[]
  employmentHistory TeacherEmploymentHistory[]
  attendance   TeacherAttendance[]
  performanceReviews TeacherPerformanceReview[]
  leaveRequests TeacherLeaveRequest[]
  salaryRecords TeacherSalary[]
  documents    TeacherDocument[]
  courses      Course[]

  @@unique([tenantId, staffNumber])
  @@index([tenantId, schoolId])
  @@map("teachers")
}

enum GradeLevel {
  NURSERY
  KG
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

model ClassGroup {
  id            String     @id @default(cuid())
  tenantId      String
  schoolId      String
  name          String
  gradeLevel    GradeLevel @default(PRIMARY)
  roomNumber    String?
  capacity      Int        @default(40)
  headTeacherId String?
  academicYear  String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  school      School             @relation(fields: [schoolId], references: [id])
  headTeacher Teacher?           @relation(fields: [headTeacherId], references: [id])
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  grades      Grade[]
  subjects    ClassSubject[]
  timetableSlots TimetableSlot[]
  transfersFrom StudentTransfer[] @relation("TransferFromClass")
  transfersTo   StudentTransfer[] @relation("TransferToClass")
  promotionsFrom StudentPromotion[] @relation("PromotionFromClass")
  promotionsTo   StudentPromotion[] @relation("PromotionToClass")
  termResults   TermResult[]
  feeStructures FeeStructure[]
  invoices      Invoice[]

  @@unique([tenantId, schoolId, name, academicYear])
  @@index([tenantId, schoolId])
  @@map("class_groups")
}

model Subject {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  credits     Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  classSub ClassSubject[]
  grades   Grade[]
  timetableSlots TimetableSlot[]
  courses  Course[]
  exams    Exam[]
  subjectResults SubjectResult[]

  @@unique([tenantId, code])
  @@map("subjects")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

model Enrollment {
  id           String           @id @default(cuid())
  tenantId     String
  studentId    String
  classGroupId String
  academicYear String
  term         String           @default("FIRST")
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, academicYear, term])
  @@index([tenantId, classGroupId, academicYear])
  @@map("enrollments")
}

model ClassSubject {
  id           String   @id @default(cuid())
  tenantId     String
  classGroupId String
  subjectId    String
  teacherId    String?
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher?   @relation(fields: [teacherId], references: [id])

  @@unique([tenantId, classGroupId, subjectId])
  @@index([tenantId, teacherId])
  @@map("class_subjects")
}

// ---------- Daily Operations ----------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSource {
  MANUAL
  QR
  IMPORT
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  tenantId     String
  studentId    String
  classGroupId String
  subjectId    String?
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  source       AttendanceSource @default(MANUAL)
  remark       String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  student       Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup    ClassGroup             @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  notifications ParentNotificationLog[]

  @@unique([tenantId, studentId, classGroupId, date, subjectId])
  @@index([tenantId, classGroupId, date])
  @@map("attendance_records")
}

enum NotificationChannel {
  EMAIL
  SMS
}

model ParentNotificationLog {
  id        String              @id @default(cuid())
  tenantId  String
  studentId String
  recordId  String?
  channel   NotificationChannel @default(EMAIL)
  recipient String?
  subject   String
  body      String
  status    String              @default("SENT")
  error     String?
  createdAt DateTime            @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord? @relation(fields: [recordId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, studentId])
  @@map("parent_notification_logs")
}

enum GradeTerm {
  FIRST
  SECOND
  THIRD
}

model Grade {
  id           String    @id @default(cuid())
  tenantId     String
  studentId    String
  classGroupId String
  subjectId    String
  academicYear String
  term         GradeTerm
  score        Float?
  letterGrade  String?
  remark       String?
  recordedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, subjectId, academicYear, term])
  @@index([tenantId, classGroupId, academicYear, term])
  @@map("grades")
}

// ---------- Student Information System ----------

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SIBLING
  GRANDPARENT
  OTHER
}

model Guardian {
  id             String              @id @default(cuid())
  tenantId       String
  studentId      String
  firstName      String
  lastName       String
  relationship   GuardianRelationship
  phone          String?
  email          String?
  address        String?
  occupation     String?
  isPrimary      Boolean             @default(false)
  isEmergencyContact Boolean          @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("guardians")
}

enum MedicalRecordType {
  CHECKUP
  IMMUNIZATION
  CONDITION
  ALLERGY
  MEDICATION
  OTHER
}

model MedicalRecord {
  id          String            @id @default(cuid())
  tenantId    String
  studentId   String
  recordType  MedicalRecordType @default(CHECKUP)
  title       String
  description String?
  recordDate  DateTime?
  notes       String?
  recordedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("medical_records")
}

enum DisciplineCategory {
  MISCONDUCT
  ACADEMIC_DISHONESTY
  BULLYING
  ATTENDANCE
  OTHER
}

enum DisciplineSeverity {
  MINOR
  MAJOR
  SEVERE
}

enum DisciplineStatus {
  OPEN
  RESOLVED
  APPEALED
}

model DisciplineRecord {
  id          String            @id @default(cuid())
  tenantId    String
  studentId   String
  category    DisciplineCategory
  severity    DisciplineSeverity
  incidentDate DateTime
  description String
  actionTaken String?
  status      DisciplineStatus  @default(OPEN)
  recordedById String?
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("discipline_records")
}

enum DocumentCategory {
  BIRTH_CERTIFICATE
  REPORT_CARD
  MEDICAL
  TRANSFER_CERTIFICATE
  ID_PHOTO
  OTHER
}

model StudentDocument {
  id          String           @id @default(cuid())
  tenantId    String
  studentId   String
  name        String
  category    DocumentCategory @default(OTHER)
  fileId      String?
  fileName    String?
  mimeType    String?
  fileSize    Int?
  notes       String?
  uploadedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  file    StoredFile? @relation(fields: [fileId], references: [id])

  @@index([tenantId, studentId])
  @@map("student_documents")
}

enum TransferStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

model StudentTransfer {
  id             String         @id @default(cuid())
  tenantId       String
  studentId      String
  fromSchoolId   String?
  toSchoolId     String
  fromClassGroupId String?
  toClassGroupId String?
  reason         String?
  transferDate   DateTime
  status         TransferStatus @default(PENDING)
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  completedById  String?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSchool  School?     @relation("TransferFromSchool", fields: [fromSchoolId], references: [id])
  toSchool    School?     @relation("TransferToSchool", fields: [toSchoolId], references: [id])
  fromClassGroup ClassGroup? @relation("TransferFromClass", fields: [fromClassGroupId], references: [id])
  toClassGroup   ClassGroup? @relation("TransferToClass", fields: [toClassGroupId], references: [id])

  @@index([tenantId, studentId])
  @@map("student_transfers")
}

enum PromotionStatus {
  PENDING
  COMPLETED
}

model StudentPromotion {
  id               String          @id @default(cuid())
  tenantId         String
  studentId        String
  fromClassGroupId String
  toClassGroupId   String
  fromGradeLevel   String
  toGradeLevel     String
  academicYear     String
  promotionDate    DateTime
  status           PromotionStatus @default(PENDING)
  createdById      String?
  promotedById     String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassGroup ClassGroup? @relation("PromotionFromClass", fields: [fromClassGroupId], references: [id])
  toClassGroup   ClassGroup? @relation("PromotionToClass", fields: [toClassGroupId], references: [id])

  @@index([tenantId, studentId])
  @@map("student_promotions")
}

enum TimelineEventType {
  REGISTRATION
  PROFILE_UPDATE
  ENROLLMENT
  PROMOTION
  TRANSFER
  DISCIPLINE
  MEDICAL
  DOCUMENT
  ATTENDANCE
  STATUS_CHANGE
  GUARDIAN
  OTHER
}

model TimelineEvent {
  id          String            @id @default(cuid())
  tenantId    String
  studentId   String
  eventType   TimelineEventType
  title       String
  description String?
  actorId     String?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?


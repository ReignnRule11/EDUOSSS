model AssignmentSubmission {
  id            String         @id @default(cuid())
  tenantId      String
  assignmentId  String
  enrollmentId  String
  content       String?
  attachmentUrl String?
  submittedAt   DateTime       @default(now())
  score         Int?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  status        SubmissionStatus @default(SUBMITTED)


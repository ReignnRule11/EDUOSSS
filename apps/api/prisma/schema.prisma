  courseId     String
  lessonId     String?
  createdById  String
  title        String
  instructions String?
  dueAt        DateTime?
  maxScore     Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?


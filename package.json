{
  "name": "eduos",
  "version": "1.0.0",
  "private": true,
  "description": "EduOS - Production-ready Enterprise School Management System",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w @eduos/api",
    "db:migrate": "npm run db:migrate -w @eduos/api",
    "db:seed": "npm run db:seed -w @eduos/api",
    "db:studio": "npm run db:studio -w @eduos/api",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.4"
}
